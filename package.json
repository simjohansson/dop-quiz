{
  "name": "dop-quiz",
  "version": "1.0.0",
  "type": "module",
  "description": "0-100 Citron-Quiz för fest och dop",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node server/server.js",
    "client": "vite",
    "tunnel": "export $(grep -v '^#' .env 2>/dev/null | xargs) && cloudflared tunnel run",
    "tunnel:quick": "cloudflared tunnel --url http://localhost:3001",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "start": "NODE_ENV=production node server/server.js",
    "restart": "launchctl kickstart -k gui/$(id -u)/se.levinsson.citron.server",
    "reload": "npm run build && npm run restart",
    "logs": "tail -f ~/Library/Logs/dop-quiz/server.log",
    "logs:tunnel": "tail -f ~/Library/Logs/dop-quiz/tunnel.log"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "lucide-react": "^1.47.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
